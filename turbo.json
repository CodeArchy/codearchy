{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "out/**",
                "dist/**",
                "parsers/**",
                "wasm/**",
                "!dist/kokoro-model/**"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ]
        },
        "lint": {},
        "test:unit": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "out/**"
            ]
        },
        "test:webview": {}
    }
}
