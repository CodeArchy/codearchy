{
    "name": "codearchy-monorepo",
    "private": true,
    "description": "CodeArchy monorepo: the VS Code extension (apps/vscode) and, as Phase 1 lands, the shared engine, platform adapters and UI packages.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/CodeArchy/codearchy"
    },
    "packageManager": "pnpm@10.34.9",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "build": "turbo run build",
        "lint": "node tooling/check-boundaries.mjs && turbo run lint",
        "typecheck": "turbo run typecheck",
        "test:unit": "turbo run test:unit",
        "test": "turbo run test:unit test:webview",
        "package:vscode": "pnpm --filter codearchy run package",
        "test:browser": "pnpm --filter @codearchy/platform-browser run test:browser",
        "test:e2e": "pnpm --filter @codearchy/playground run test:e2e",
        "playground": "pnpm --filter @codearchy/playground run dev",
        "new:language": "node tooling/new-language.mjs"
    },
    "devDependencies": {
        "turbo": "2.11.10"
    }
}
