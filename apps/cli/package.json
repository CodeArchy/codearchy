{
    "name": "@codearchy/cli",
    "version": "0.1.0",
    "private": true,
    "description": "The codearchy command line. `codearchy mcp` serves the architecture map to your own AI agent (Claude Code, Codex, Gemini CLI, Copilot) over the Model Context Protocol.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "codearchy": "./dist/main.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test:unit": "tsc -p tsconfig.json && vitest run"
    },
    "dependencies": {
        "@codearchy/ai": "workspace:*",
        "@codearchy/core": "workspace:*",
        "@codearchy/platform-node": "workspace:*",
        "@codearchy/protocol": "workspace:*",
        "@modelcontextprotocol/sdk": "1.32.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "typescript": "5.9.3",
        "vitest": "5.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/CodeArchy/codearchy",
        "directory": "apps/cli"
    }
}
