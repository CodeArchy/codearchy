{
    "name": "codearchy",
    "displayName": "CodeArchy",
    "description": "Offline-first privacy system that visualizes codebase into explainable system architecture for education, onboarding, and safer software development/maintenance",
    "version": "2.0.0",
    "publisher": "iyinusa",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/CodeArchy/codearchy",
        "directory": "apps/vscode"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "keywords": [
        "architecture",
        "visualization",
        "education",
        "AI",
        "Chat"
    ],
    "icon": "media/icon.jpg",
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "codearchy.showArchitecture",
                "title": "CodeArchy: Show Architecture",
                "icon": "$(type-hierarchy)"
            },
            {
                "command": "codearchy.analyzeWorkspace",
                "title": "CodeArchy: Analyze Workspace"
            },
            {
                "command": "codearchy.refreshView",
                "title": "CodeArchy: Refresh Architecture",
                "icon": "$(refresh)"
            },
            {
                "command": "codearchy.exportSVG",
                "title": "CodeArchy: Export as SVG"
            },
            {
                "command": "codearchy.exportPNG",
                "title": "CodeArchy: Export as PNG"
            },
            {
                "command": "codearchy.openSidebar",
                "title": "CodeArchy: Open Sidebar"
            },
            {
                "command": "codearchy.revealInMap",
                "title": "CodeArchy: Reveal in Map",
                "icon": "$(type-hierarchy)"
            },
            {
                "command": "codearchy.switchUi",
                "title": "CodeArchy: Switch between the Map and the classic views"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "codearch-explorer",
                    "title": "CodeArchy",
                    "icon": "media/icon.png"
                }
            ]
        },
        "views": {
            "codearch-explorer": [
                {
                    "id": "codearchy.commandsView",
                    "name": "CodeArchy",
                    "icon": "media/icon.png"
                },
                {
                    "id": "codearchy.modulesView",
                    "name": "Modules",
                    "icon": "media/icon.png"
                }
            ]
        },
        "menus": {
            "editor/title": [
                {
                    "command": "codearchy.showArchitecture",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "codearchy.revealInMap",
                    "group": "navigation@90"
                }
            ],
            "explorer/context": [
                {
                    "command": "codearchy.revealInMap",
                    "when": "!explorerResourceIsFolder",
                    "group": "navigation@90"
                }
            ]
        },
        "configuration": {
            "title": "CodeArchy",
            "properties": {
                "codearchy.ui": {
                    "type": "string",
                    "enum": [
                        "map",
                        "classic"
                    ],
                    "default": "map",
                    "enumDescriptions": [
                        "The new Map (2.0): drill-down architecture with Matrix, lenses, Navigator and Inspector.",
                        "The classic views from 1.x: System, Flow and Dense. Kept through the 2.0 beta while you get familiar with the Map."
                    ],
                    "markdownDescription": "Which architecture view the CodeArchy panel shows. The classic System/Flow/Dense views remain available during the 2.0 beta. Also: **CodeArchy: Switch between the Map and the classic views**."
                },
                "codearchy.codeLens": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show where each file sits in the architecture (and what it uses / is used by) as a CodeLens at the top of the file."
                },
                "codearchy.includedLanguages": {
                    "type": "array",
                    "default": [
                        "typescript",
                        "javascript",
                        "python",
                        "java",
                        "kotlin",
                        "go",
                        "rust",
                        "csharp",
                        "php",
                        "ruby"
                    ],
                    "description": "Languages to include in architecture analysis.",
                    "items": {
                        "type": "string",
                        "enum": [
                            "typescript",
                            "javascript",
                            "python",
                            "java",
                            "kotlin",
                            "go",
                            "rust",
                            "csharp",
                            "php",
                            "ruby"
                        ]
                    }
                },
                "codearchy.excludePatterns": {
                    "type": "array",
                    "default": [
                        "**/node_modules/**",
                        "**/dist/**",
                        "**/out/**",
                        "**/build/**",
                        "**/.git/**",
                        "**/vendor/**",
                        "**/target/**",
                        "**/__pycache__/**",
                        "**/.venv/**",
                        "**/venv/**",
                        "**/.next/**",
                        "**/coverage/**",
                        "**/*.min.js"
                    ],
                    "description": "Glob patterns to exclude from analysis. Files ignored by .gitignore are always excluded in git repositories."
                },
                "codearchy.maxFileSize": {
                    "type": "number",
                    "default": 500000,
                    "description": "Maximum file size in bytes to analyze."
                },
                "codearchy.maxFiles": {
                    "type": "number",
                    "default": 20000,
                    "minimum": 0,
                    "description": "Maximum number of source files to analyze (0 = no limit). CodeArchy warns when a workspace exceeds it."
                },
                "codearchy.aiModel": {
                    "type": "string",
                    "enum": [
                        "gemma-e2b",
                        "gemma-e4b",
                        "none"
                    ],
                    "default": "none",
                    "description": "Local AI model for architecture inference. 'none' uses heuristic grouping."
                },
                "codearchy.aiProcessing": {
                    "type": "string",
                    "enum": [
                        "fast",
                        "moderate",
                        "indepth"
                    ],
                    "enumDescriptions": [
                        "Smallest prompt, lowest token budget — fastest responses.",
                        "Balanced prompt size and depth (default).",
                        "Largest prompt, full reasoning with thinking tokens — slowest, deepest analysis."
                    ],
                    "default": "moderate",
                    "description": "AI processing tier. Trades response speed for analytical depth."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "node scripts/prepublish.js",
        "build:webview": "node webview-ui/esbuild.js",
        "compile": "tsc -p tsconfig.test.json",
        "build": "node scripts/build.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "watch": "node scripts/build.mjs --watch",
        "grammars": "node scripts/build.mjs --parsers-only",
        "download-kokoro": "node scripts/download-kokoro.js",
        "lint": "eslint src --ext ts",
        "test": "npm run compile && vscode-test",
        "test:unit": "npm run compile && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
        "test:webview": "node --test \"webview-ui/test/*.test.ts\"",
        "bench": "node scripts/bench.mjs",
        "package": "vsce package --no-dependencies"
    },
    "devDependencies": {
        "@codearchy/core": "workspace:*",
        "@codearchy/grammars": "workspace:*",
        "@codearchy/platform-node": "workspace:*",
        "@codearchy/protocol": "workspace:*",
        "@codearchy/treesitter": "workspace:*",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.85.0",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^8.73.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.1.1",
        "esbuild": "0.25.12",
        "eslint": "^8.56.0",
        "mocha": "^12.0.3",
        "typescript": "^5.3.0"
    }
}
