{
    "$comment": "Typecheck only. dist/extension.js is bundled by scripts/build.mjs (esbuild); tests are compiled by tsconfig.test.json.",
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["ES2022"],
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": ["node", "mocha"]
    },
    "include": ["src"]
}
