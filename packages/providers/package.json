{
    "name": "@codearchy/providers",
    "version": "0.1.0",
    "description": "CodeArchy's AI provider layer: one streaming chat interface over Ollama, OpenAI-compatible endpoints, Anthropic and Gemini. Runs in Node, browsers and workers.",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test:unit": "vitest run"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "1.6.0"
    },
    "devDependencies": {
        "typescript": "5.9.3",
        "vitest": "5.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/CodeArchy/codearchy",
        "directory": "packages/providers"
    }
}
