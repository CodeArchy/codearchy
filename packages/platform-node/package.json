{
    "name": "@codearchy/platform-node",
    "version": "0.1.0",
    "description": "Node.js adapters for @codearchy/core: file system, git discovery, tree-sitter runtime.",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test:unit": "tsc -p tsconfig.json && vitest run"
    },
    "dependencies": {
        "@codearchy/core": "workspace:*",
        "@codearchy/grammars": "workspace:*",
        "@codearchy/protocol": "workspace:*",
        "@codearchy/treesitter": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "typescript": "5.9.3",
        "vitest": "5.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/CodeArchy/codearchy",
        "directory": "packages/platform-node"
    }
}
