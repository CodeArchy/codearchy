{
    "name": "@codearchy/ai",
    "version": "0.1.0",
    "description": "CodeArchy's AI orchestration: bottom-up summary cards for the architecture hierarchy, built on @codearchy/providers. AI upgrades deterministic cards and never blocks on them.",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test:unit": "vitest run"
    },
    "dependencies": {
        "@codearchy/core": "workspace:*",
        "@codearchy/protocol": "workspace:*",
        "@codearchy/providers": "workspace:*"
    },
    "devDependencies": {
        "@codearchy/platform-node": "workspace:*",
        "typescript": "5.9.3",
        "vitest": "5.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/CodeArchy/codearchy",
        "directory": "packages/ai"
    }
}
