{
    "name": "@codearchy/protocol",
    "version": "0.1.0",
    "description": "CodeArchy data model shared by the engine, hosts and UI (types only, no runtime dependencies).",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
