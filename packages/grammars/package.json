{
    "name": "@codearchy/grammars",
    "version": "0.1.0",
    "description": "Pinned tree-sitter grammar WASM files for CodeArchy, fetched from npm and integrity-verified.",
    "license": "MIT",
    "type": "module",
    "exports": {
        "./grammars.json": "./grammars.json",
