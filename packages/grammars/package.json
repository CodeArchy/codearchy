    },
    "files": ["grammars.json", "wasm"],
    "scripts": {
        "build": "node scripts/fetch.cjs",
        "fetch": "node scripts/fetch.cjs"
    },
    "repository": { "type": "git", "url": "https://github.com/CodeArchy/codearchy", "directory": "packages/grammars" }
}
